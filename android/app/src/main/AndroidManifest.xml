<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wiseasy SDK4 printer. Declared by their own SDK Demo, which prints on our P5
         units. System-level sharing is NOT required: the demo's
         sharedUserId="android.uid.system" is commented out and we set none either. -->
    <uses-permission android:name="com.pos.permission.PRINTER" />

    <!-- Private POS APK: needed so queryIntentServices can see the system USDK
         printer service on Android 11+ when intent-filter visibility alone is insufficient. -->
    <uses-permission
      android:name="android.permission.QUERY_ALL_PACKAGES"
      tools:ignore="QueryAllPackagesPermission" />

    <!-- Bluetooth receipt printer (PrinterModule.kt / DantSu ESCPOS-ThermalPrinter-Android).
         Legacy permissions for API 30 and below, new granular ones for API 31+. Paired device
         lookup only, never active discovery, so BLUETOOTH_SCAN never needs location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
      android:name="android.permission.BLUETOOTH_SCAN"
      android:usesPermissionFlags="neverForLocation" />

    <queries>
        <intent>
            <action android:name="com.wiseasy.transaction.call" />
        </intent>
        <!-- WisePos printer/device AIDL (WiseSdk_P). Required for targetSdk 30+ package visibility;
             without this, initPosSdk fails with ERR_SDK_INVALID_PARAMETER (7101). -->
        <intent>
            <action android:name="com.wisepos.aidl.service" />
        </intent>
        <!-- SDK4 binder pool: the transport WiseSdk4PrinterModule binds. Its
             BaseBinder resolves this action via queryIntentServices and requires
             EXACTLY one match, so visibility of it must be explicit. -->
        <intent>
            <action android:name="wangpos.sdk4.base.service.BinderPoolService" />
        </intent>
        <intent>
            <action android:name="com.wisedevice.aidl.service" />
        </intent>
        <intent>
            <action android:name="android.printservice.PrintService" />
        </intent>
        <package android:name="com.android.bips" />
        <package android:name="com.wiseasy.usdk" />
        <package android:name="com.wiseasy.service" />
        <package android:name="wangpos.sdk4.base" />
        <package android:name="com.sdksuite.usdk" />
        <package android:name="com.wiseasy.cashier" />
        <package android:name="com.wiseasy.pay" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
