rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    /* ---------- USERS ---------- */
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
    
    /* ---------- RESTAURANTS ---------- */
    match /restaurants/{restaurantId} {
      // Public read for customer menus
      allow read: if true;
      
      // Only authenticated users can create
      allow create: if request.auth != null;
      
      // Only owner can update (simple check - no helper function)
      allow update: if request.auth != null && 
                       request.auth.uid == resource.data.owner_id;
      
      allow delete: if false;
      
      /* ---------- MENU CATEGORIES ---------- */
      match /menu/data {
        allow read: if true; // Public
        allow write: if request.auth != null;
        
        match /categories/{categoryId} {
          allow read: if true; // Public
          allow write: if request.auth != null;
          
          match /subcategories/{subcategoryId} {
            allow read: if true; // Public
            allow write: if request.auth != null;
            
            match /items/{itemId} {
              allow read: if true; // Public
              allow write: if request.auth != null;
            }
          }
        }
      }
      
      /* ---------- TABLES - MUST BE PUBLIC ---------- */
      match /tables/{tableId} {
        // CRITICAL: Unconditionally public for QR codes - NO helper functions
        allow read: if true;
        
        // Write requires authentication only
        allow create, update, delete: if request.auth != null;
        
        match /current_session/{sessionId} {
          allow read, create, update: if true;
          allow delete: if false;
        }
      }
      
      /* ---------- ORDERS ---------- */
      match /orders/{orderId} {
        // Anyone can create (customers)
        allow create: if true;
        
        // Only authenticated users can read
        allow read: if request.auth != null;
        
        // Only authenticated users can update
        // Owner of the restaurant can always update orders
        // restaurantId is available from the parent path: restaurants/{restaurantId}/orders/{orderId}
        allow update: if request.auth != null && 
                       exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
                       request.auth.uid == get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.owner_id;
        
        allow delete: if false;
      }
      
      /* ---------- ANALYTICS ---------- */
      match /analytics/daily/{date} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
