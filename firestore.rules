rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(restaurantId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        request.auth.uid == get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.owner_id;
    }

    /* ---------- USERS ---------- */
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    /* ---------- RESTAURANTS ---------- */
    match /restaurants/{restaurantId} {

      // Step 1: Anyone can read restaurant docs — customers browse menus without login
      allow read: if true;

      allow create: if request.auth != null;

      allow update: if request.auth != null &&
                       request.auth.uid == resource.data.owner_id;

      allow delete: if false;

      /* ---------- MENU (nested) ---------- */
      match /menu/data {
        allow read: if true;
        allow write: if request.auth != null;

        match /categories/{categoryId} {
          allow read: if true;
          allow write: if request.auth != null;

          match /subcategories/{subcategoryId} {
            allow read: if true;
            allow write: if request.auth != null;

            match /items/{itemId} {
              allow read: if true;
              allow write: if request.auth != null;
            }
          }
        }
      }

      /* ---------- TABLES ---------- */
      match /tables/{tableId} {
        allow read: if true;
        allow create, update, delete: if request.auth != null;

        match /current_session/{sessionId} {
          allow read, create, update: if true;
          allow delete: if false;
        }
      }

      /* ---------- ORDERS ----------
       * - Anyone can create orders (unauthenticated QR customers; optional direct client create).
       * - Read: owner may read all orders; others may read only orders where is_closed == false.
       * - Only the restaurant owner (authenticated) may update orders (dashboard).
       * - Deletes denied (audit); use Admin SDK if you ever need server-side delete.
       */
      match /orders/{orderId} {
        allow create: if true;
        allow read: if isOwner(restaurantId)
          || (resource != null && resource.data.is_closed == false);
        allow update: if request.auth != null &&
                         exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
                         request.auth.uid == get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.owner_id;
        allow delete: if false;
      }

      /* ---------- ANALYTICS ---------- */
      match /analytics/daily/{date} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
