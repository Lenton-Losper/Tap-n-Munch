# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
/coverage
/test-results/

# Next.js
/.next/
# OpenNext build output. Never commit an artifact -- a Windows-built one 500s every route
# (see scripts/deploy/check-opennext-artifact.mjs).
/.open-next/
# Written by the deploy sequence: the version to roll back to. Machine-local.
/.deploy/
# Large synthetic artifacts written by the deploy gate tests. Kept on the repo drive so a
# full system drive cannot make an environmental ENOSPC look like a broken gate.
/.tmp-tests/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

